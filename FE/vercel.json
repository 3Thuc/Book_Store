{
  "rewrites": [
    {
      "source": "/bookdb/:path*",
      "destination": "https://success-fax-budgets-vatican.trycloudflare.com/bookdb/:path*"
    },
    {
      "source": "/minio/:path*",
      "destination": "https://talk-book-complexity-font.trycloudflare.com/:path*"
    },
    {
      "source": "/bookstore/:path*",
      "destination": "https://talk-book-complexity-font.trycloudflare.com/bookstore/:path*"
    },
    {
      "source": "/pyapi/:path*",
      "destination": "https://book101.datateam.space/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
