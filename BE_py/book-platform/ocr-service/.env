# ===================== OCR SERVICE — Local Development .env =====================
# File này được load_dotenv() trong config.py đọc khi chạy local uvicorn
# (uvicorn thường được chạy từ thư mục ocr-service/)
# Trong Docker: biến được inject qua docker-compose.yml → file này bị bỏ qua

# ── MySQL ──────────────────────────────────────────────────────────────────────
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=1900561275Nghia
MYSQL_DB=bookstore

# ── Search Service (port 8000) ─────────────────────────────────────────────────
SEARCH_SERVICE_URL=http://localhost:8000

# ── MinIO ──────────────────────────────────────────────────────────────────────
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=admin
MINIO_SECRET_KEY=admin123456789
MINIO_OCR_BUCKET=ocr-uploads
MINIO_BUCKET=bookstore
MINIO_USE_HTTPS=false

# ── Google Books API (optional) ────────────────────────────────────────────────
GOOGLE_BOOKS_API_KEY=AIzaSyDPq703Q0sJehGBKJasgw3zEVvzn8FM9E4

# ── Admin Security ────────────────────────────────────────────────────────────
# Dùng chung key với các service khác
ADMIN_API_KEY=ed8fc15c4634bdbdf4fe16135f717ffad99afb49d6c7cd60b089797c7b04aac5

# ── CORS ──────────────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:3000

# ── pHash Index Persistence ───────────────────────────────────────────────────
# File pickle lưu visual hash index — load <1s khi restart thay vì rebuild 30-60s
# Đường dẫn Windows (dùng forward slash hoặc escape backslash đều được)
PHASH_INDEX_PATH=D:/12_22110190_22110243_XayDungWebsiteBanSachTichHopHeThongGoiY/source-code/BE_py/book-platform/ocr-service/tmp/ocr_phash_index.pkl

# ── OCR Settings ──────────────────────────────────────────────────────────────
MAX_IMAGE_SIZE_MB=10
OCR_CONFIDENCE_THRESHOLD=0.3
